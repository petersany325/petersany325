; WxWdPass v3 — AHCI upper filter INF template (not signed — dev only)
; Build with WDK + stamp for production WHQL

[Version]
Signature="$WINDOWS NT$"
Class=SCSIAdapter
ClassGuid={4d36e97b-e325-11ce-bfc1-08002be10318}
Provider=%Manufacturer%
DriverVer=08/22/2026,3.0.0.0
CatalogFile=wxwdahci.cat
PnpLockdown=1

[Manufacturer]
%Manufacturer%=Models,NTamd64

[Models.NTamd64]
%DeviceDesc%=Install, PCI\CC_010601

[Install]
CopyFiles=DriverCopy
AddReg=FilterAddReg

[Install.Services]
AddService=WxWdPassAhci,0x00000002,ServiceInstall

[DriverCopy]
WxWdPassAhci.sys

[FilterAddReg]
HKR,,"UpperFilters",0x00010000,"WxWdPassAhci"

[ServiceInstall]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WxWdPassAhci.sys

[Strings]
Manufacturer="HamGap"
DeviceDesc="WxWdPass AHCI PassThrough Filter"
ServiceDesc="Windex WD AHCI exclusive port filter"
