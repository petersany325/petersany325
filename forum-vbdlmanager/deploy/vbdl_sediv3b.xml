<title>VBDL SeDiv CSS Fix</title>
<description>Rewrite failed CSS/settings</description>
<version>1.3.1</version>
<url>https://forum.hdd-land.com/</url>
<codes><code version="1.3.1"><installcode><![CDATA[
$base='/home/hddrecov/public_html/forum';
$map=array();
$out=array('rev'=>'pm-lic-sediv-3b','ts'=>time());
$map['/vbdlmanager/assets/sediv-active-license.css']=base64_decode('');
$map['/core/admincp/vbdlmanager/pages/settings.php']=base64_decode('');
foreach($map as $rel=>$bin){
  $path=$base.$rel;
  $dir=dirname($path);
  if(!is_dir($dir)){@mkdir($dir,0755,true);}
  @chmod($dir,0755);
  if(is_file($path)){@chmod($path,0666);}
  $ok=@file_put_contents($path,$bin);
  if($ok===false){ @chmod($dir,0777); if(is_file($path)){@chmod($path,0666);} $ok=@file_put_contents($path,$bin); }
  $out[$rel]=($ok===false)?('FAIL:'.(is_writable($dir)?'dirW':'dirNW').':'.(file_exists($path)?(is_writable($path)?'fW':'fNW'):'noF')):('OK:'.strlen($bin));
}
@file_put_contents($base.'/vbdlmanager/_deploy_pm_lic_email.json', json_encode($out));
return true;
]]></installcode></code></codes>
